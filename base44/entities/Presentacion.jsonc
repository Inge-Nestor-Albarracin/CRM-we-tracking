{
  "name": "Presentacion",
  "type": "object",
  "properties": {
    "titulo": { "type": "string", "title": "Título" },
    "categoria": {
      "type": "string",
      "title": "Categoría",
      "enum": ["Comercial", "Producto", "Caso_Exito", "Institucional", "Propuesta", "Otro"],
      "default": "Comercial"
    },
    "tipo": {
      "type": "string",
      "title": "Tipo de fuente",
      "enum": ["link", "archivo"],
      "default": "link",
      "description": "link = Canva/Google Slides; archivo = PDF o PowerPoint subido"
    },
    "url": {
      "type": "string",
      "title": "URL",
      "description": "Link de Canva/Slides o URL del archivo subido (UploadFile)"
    },
    "tipo_mime": { "type": "string", "description": "Tipo MIME si es archivo (ej. application/pdf, application/vnd.openxmlformats-officedocument.presentationml.presentation)" },
    "portada_url": { "type": "string", "title": "Portada", "description": "URL de una imagen de portada opcional para mostrar en la tarjeta" },
    "descripcion": { "type": "string", "title": "Descripción" },
    "activo": { "type": "boolean", "default": true }
  },
  "required": ["titulo", "url"],
  "rls": {
    "read": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "role": "user" } }] },
    "create": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "role": "user" } }] },
    "update": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "role": "user" } }] },
    "delete": { "$or": [{ "user_condition": { "role": "admin" } }, { "user_condition": { "role": "user" } }] }
  }
}
